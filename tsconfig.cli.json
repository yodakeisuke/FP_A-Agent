{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "types": ["node"],
    "declaration": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "lib": ["es2022"],
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["app/**/*", ".next/**/*", "node_modules"]
}
